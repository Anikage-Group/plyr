{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plyr",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Always run the Worker first so /e/* and /d/* never hit the static
    // asset router (which would 404 them) and every response gets headers.
    "run_worker_first": true
  }
}
